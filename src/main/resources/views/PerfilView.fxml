<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefHeight="547.0" prefWidth="570.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.petshoppoo.controllers.PerfilController" stylesheets="@../styles/petshop.css">
    <content>
        <VBox alignment="CENTER" spacing="15.0">
        <padding><Insets bottom="15.0" left="15.0" right="15.0" top="15.0" /></padding>
            <children>

                <VBox alignment="TOP_CENTER" maxWidth="520.0" styleClass="profile-card" prefHeight="509.0" prefWidth="478.0" spacing="20.0">

                    <children>
                        <HBox alignment="CENTER_LEFT" prefWidth="390.0">
                            <children>
                                <Button fx:id="btnVoltar" styleClass="secondary" mnemonicParsing="false" onAction="#handleVoltar" prefHeight="38.0" prefWidth="36.0" text="🔙">
                                    <font>
                                        <Font name="System Bold" size="14.0" />
                                    </font>
                                </Button>
                                <Region HBox.hgrow="ALWAYS" />
                                <Label styleClass="page-title" text="PERFIL">
                                    <font>
                                        <Font name="System Bold" size="20.0" />
                                    </font>
                                </Label>
                                <Region HBox.hgrow="ALWAYS" />
                                <Label text="🐾" />
                            </children>
                        </HBox>

                        <Separator prefWidth="200.0" />

                        <VBox alignment="CENTER" spacing="10.0">
                            <children>
                                <ImageView fitHeight="100.0" fitWidth="100.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../images/FotoPerfil.png" />
                                    </image>
                                </ImageView>
                                <Label text="Dados da Conta">
                                    <font>
                                        <Font size="13.0" />
                                    </font>
                                </Label>
                            </children>
                        </VBox>

                        <VBox spacing="15.0">
                            <children>
                                <VBox spacing="5.0">
                                    <children>
                                        <Label text="🙎‍♂️ Nome Completo" />
                                        <TextField fx:id="nome" prefHeight="40.0" />
                                    </children>
                                </VBox>

                                <VBox spacing="5.0">
                                    <children>
                                        <Label text="📧 E-mail" />
                                        <TextField fx:id="email" prefHeight="40.0" />
                                    </children>
                                </VBox>

                                <VBox spacing="5.0">
                                    <children>
                                        <Label text="📞 Telefone" />
                                        <TextField fx:id="telefone" prefHeight="40.0" />
                                    </children>
                                </VBox>

                                <Separator prefWidth="200.0" />

                                <VBox spacing="5.0">
                                    <children>
                                        <Label text="🔒 Alterar Senha" />

                                        <VBox spacing="8.0">
                                            <children>
                                                <VBox spacing="5.0">
                                                    <children>
                                                        <Label text="Senha Atual">
                                                            <font>
                                                                <Font size="12.0" />
                                                            </font>
                                                        </Label>
                                                        <PasswordField fx:id="senhaAtual" prefHeight="35.0" />
                                                    </children>
                                                </VBox>

                                                <VBox spacing="5.0">
                                                    <children>
                                                        <Label text="Nova Senha">
                                                            <font>
                                                                <Font size="12.0" />
                                                            </font>
                                                        </Label>
                                                        <PasswordField fx:id="novaSenha" prefHeight="35.0" />
                                                    </children>
                                                </VBox>

                                                <VBox spacing="5.0">
                                                    <children>
                                                        <Label text="Confirmar Nova Senha">
                                                            <font>
                                                                <Font size="12.0" />
                                                            </font>
                                                        </Label>
                                                        <PasswordField fx:id="confirmarSenha" prefHeight="35.0" />
                                                    </children>
                                                </VBox>
                                            </children>
                                        </VBox>
                                    </children>
                                </VBox>
                            </children>
                        </VBox>


                        <Button fx:id="btnSalvar" mnemonicParsing="false" onAction="#handleSalvar" prefHeight="45.0" prefWidth="390.0" text="💾 SALVAR ALTERAÇÕES">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Button>
                    </children>
                </VBox>

            </children>
        </VBox>
    </content>
</ScrollPane>
