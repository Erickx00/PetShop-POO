<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="500.0"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.petshoppoo.controllers.ServicoController" stylesheets="@../styles/petshop.css">

    <children>
        <VBox alignment="TOP_CENTER" layoutX="46.0" layoutY="14.0" prefHeight="572.0"
              prefWidth="408.0" spacing="15.0" styleClass="surface-card"

              AnchorPane.bottomAnchor="14.0" AnchorPane.leftAnchor="46.0"
              AnchorPane.rightAnchor="46.0" AnchorPane.topAnchor="14.0">

            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>

            <children>
                <Label text="🐾">
                    <font>
                        <Font size="40.0" />
                    </font>
                </Label>
                <Label styleClass="page-title" text="AGENDAR SERVIÇO">
                    <font>
                        <Font name="System Bold" size="19.0" />
                    </font>
                </Label>

                <VBox alignment="CENTER_LEFT" spacing="5.0">
                    <Label text="Selecione o Pet:" />
                    <ComboBox fx:id="comboPet" maxWidth="Infinity"
                              promptText="Escolha seu animalzinho..." />
                </VBox>

                <VBox alignment="CENTER_LEFT" spacing="5.0">
                    <Label text="Tipo de Serviço:" />
                    <ComboBox fx:id="comboServico" maxWidth="Infinity"
                              promptText="Banho, Tosa, Consulta..." />
                </VBox>

                <Label fx:id="lblValor" text="Valor: --"
                       />

                <HBox spacing="10.0">
                    <VBox alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                        <Label text="Data:" />
                        <DatePicker fx:id="datePicker" maxWidth="Infinity"
                                    promptText="Selecione a data" />
                    </VBox>
                    <VBox alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                        <Label text="Horário:" />
                        <ComboBox fx:id="comboHorario" maxWidth="Infinity"
                                  promptText="Selecione" />
                    </VBox>
                </HBox>

                <VBox alignment="CENTER_LEFT" spacing="5.0">
                    <Label text="Observações:" />
                    <TextArea fx:id="txtObservacoes" maxWidth="Infinity" prefHeight="80.0"
                              promptText="Ex: O cachorro tem alergia a perfume..."
                              wrapText="true" />
                </VBox>

                <Button mnemonicParsing="false" onAction="#handleConfirmar"
                        prefHeight="41.0" prefWidth="180.0"

                        text="Confirmar Agendamento">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Button>
            </children>
        </VBox>

        <Button mnemonicParsing="false" onAction="#voltarMenu"
                prefHeight="38.0" prefWidth="40.0"

                text="🔙"
                AnchorPane.rightAnchor="5.0" AnchorPane.topAnchor="15.0">
            <font>
                <Font name="System Bold" size="12.0" />
            </font>
        </Button>
    </children>
</AnchorPane>
