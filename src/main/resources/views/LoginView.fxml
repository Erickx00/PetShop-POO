<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="530.0" prefWidth="447.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.petshoppoo.controllers.LoginController" stylesheets="@../styles/petshop.css">
    <children>
        <VBox alignment="CENTER" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>

                <VBox alignment="TOP_CENTER" maxWidth="440.0" styleClass="auth-card" prefWidth="380.0" spacing="15.0">

                    <children>
                        <Label text="🐾🐾">
                            <font>
                                <Font size="40.0" />
                            </font>
                        </Label>

                        <Label styleClass="page-title" text="BEM VINDO À GOLDEN PET">
                            <font>
                                <Font name="System Bold" size="18.0" />
                            </font>
                            <VBox.margin>
                                <Insets bottom="10.0" />
                            </VBox.margin>
                        </Label>

                        <VBox spacing="5.0">
                            <children>
                                <Label text="E-mail">
                                    <font>
                                        <Font name="System Bold" size="13.0" />
                                    </font>
                                </Label>
                                <TextField fx:id="txtEmail" prefHeight="40.0" promptText="Digite seu e-mail" />
                            </children>
                        </VBox>

                        <VBox spacing="5.0">
                            <children>
                                <Label text="Senha">
                                    <font>
                                        <Font name="System Bold" size="13.0" />
                                    </font>
                                </Label>
                                <PasswordField fx:id="txtSenha" prefHeight="40.0" promptText="Digite sua senha" />
                            </children>
                        </VBox>

                        <Button fx:id="btnEntrar" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleLogin" prefHeight="45.0" text="ENTRAR">
                            <font>
                                <Font size="14.0" />
                            </font>
                            <VBox.margin>
                                <Insets top="15.0" />
                            </VBox.margin>
                        </Button>

                        <HBox alignment="CENTER" spacing="5.0">
                            <children>
                                <Label text="Não tem uma conta?" />
                                <Hyperlink fx:id="btnCadastrar" onAction="#handleCadastrar" text="Cadastre-se aqui" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</AnchorPane>
