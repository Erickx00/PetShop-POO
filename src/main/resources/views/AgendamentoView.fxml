<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="550.0" prefWidth="500.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.petshoppoo.controllers.AgendamentoController" stylesheets="@../styles/petshop.css">
    <children>
        <VBox alignment="TOP_CENTER" layoutX="46.0" layoutY="14.0" prefHeight="522.0" prefWidth="408.0" styleClass="surface-card" spacing="15.0" AnchorPane.bottomAnchor="14.0" AnchorPane.leftAnchor="46.0" AnchorPane.rightAnchor="46.0" AnchorPane.topAnchor="14.0">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="10.0" />
            </padding>
            <children>

                <VBox alignment="CENTER" prefHeight="0.0" prefWidth="0.0" spacing="5.0">
                    <children>
                        <Label text="🐾">
                            <font>
                                <Font size="40.0" />
                            </font>
                        </Label>
                        <Label styleClass="page-title" text="LISTA AGENDAMENTOS">
                            <font>
                                <Font name="System Bold" size="19.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>

                <TableView fx:id="tabelaAgendamentos" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colPet" prefWidth="75.0" text="Pet" />
                        <TableColumn fx:id="colData" prefWidth="75.0" text="Data" />
                        <TableColumn fx:id="colServico" prefWidth="85.0" text="Serviço" />
                        <TableColumn fx:id="colDuracao" prefWidth="75.0" text="Valor" />
                        <TableColumn fx:id="colStatus" prefWidth="95.0" text="Andamento" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

                <HBox alignment="CENTER" prefHeight="60.0">
                    <children>
                        <Button fx:id="btnCancelar" styleClass="danger" mnemonicParsing="false" onAction="#handleCancelar" maxWidth="Infinity" HBox.hgrow="ALWAYS" prefHeight="38.0" text="Cancelar Serviço">
                            <font>
                                <Font size="17.0" />
                            </font>
                        </Button>
                        <Button fx:id="btnLimpar" styleClass="secondary" mnemonicParsing="false" onAction="#handleLimpar" maxWidth="Infinity" HBox.hgrow="ALWAYS" prefHeight="38.0" text="Limpar">
                     <font>
                        <Font size="17.0" />
                     </font></Button>
                    </children>
                </HBox>

            </children>
        </VBox>

        <Button fx:id="btnVoltar" styleClass="secondary" mnemonicParsing="false" onAction="#handleVoltar" prefHeight="38.0" prefWidth="40.0" text="🔙" AnchorPane.rightAnchor="5.0" AnchorPane.topAnchor="15.0">
            <font>
                <Font name="System Bold" size="12.0" />
            </font>
        </Button>
    </children>
</AnchorPane>
