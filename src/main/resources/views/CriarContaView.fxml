<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="550.0" prefWidth="450.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.petshoppoo.controllers.CadastroController" stylesheets="@../styles/petshop.css">
    <children>
        <Button fx:id="btnCancelar" layoutX="380.0" layoutY="15.0" mnemonicParsing="false" onAction="#handleCancelar" prefHeight="35.0" prefWidth="45.0" text="🔙" AnchorPane.rightAnchor="15.0" AnchorPane.topAnchor="15.0">
            <font>
                <Font name="System Bold" size="14.0" />
            </font>
        </Button>

        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" layoutY="60.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="60.0" AnchorPane.bottomAnchor="15.0">
            <content>
                <StackPane alignment="TOP_CENTER">
                    <children>
        <VBox alignment="TOP_CENTER" maxWidth="420.0" styleClass="auth-card" prefWidth="370.0" spacing="12.0">
            <children>
                <VBox alignment="CENTER" spacing="5.0">
                    <children>
                        <Label text="🐾">
                            <font>
                                <Font size="40.0" />
                            </font>
                        </Label>
                        <Label styleClass="page-title" text="CRIE SUA CONTA">
                            <font>
                                <Font name="System Bold" size="18.0" />
                            </font>
                        </Label>
                    </children>
                    <padding>
                        <Insets top="10.0" />
                    </padding>
                </VBox>

                <VBox spacing="5.0">
                    <children>
                        <Label text="Nome e Sobrenome">
                            <font>
                                <Font name="System Bold" size="12.0" />
                            </font>
                        </Label>
                        <TextField fx:id="txtNome" prefHeight="35.0" promptText="Digite seu nome" />

                        <Label text="E-mail">
                            <font>
                                <Font name="System Bold" size="12.0" />
                            </font>
                            <VBox.margin>
                                <Insets top="5.0" />
                            </VBox.margin>
                        </Label>
                        <TextField fx:id="txtEmail" prefHeight="35.0" promptText="exemplo@gmail.com" />

                        <Label text="Telefone">
                            <font>
                                <Font name="System Bold" size="12.0" />
                            </font>
                            <VBox.margin>
                                <Insets top="5.0" />
                            </VBox.margin>
                        </Label>
                        <TextField fx:id="txtTelefone" prefHeight="35.0" promptText="(00) 00000-0000" />

                        <Label text="Senha">
                            <font>
                                <Font name="System Bold" size="12.0" />
                            </font>
                            <VBox.margin>
                                <Insets top="5.0" />
                            </VBox.margin>
                        </Label>
                        <PasswordField fx:id="txtSenha" prefHeight="35.0" promptText="Mínimo 6 dígitos" />

                        <Label text="Confirmar Senha">
                            <font>
                                <Font name="System Bold" size="12.0" />
                            </font>
                            <VBox.margin>
                                <Insets top="5.0" />
                            </VBox.margin>
                        </Label>
                        <PasswordField fx:id="txtConfirmarSenha" prefHeight="35.0" promptText="Repita sua senha" />
                    </children>
                    <padding>
                        <Insets left="25.0" right="25.0" />
                    </padding>
                </VBox>

                <Button fx:id="btnFinalizar" mnemonicParsing="false" onAction="#handleCadastrar" prefHeight="45.0" prefWidth="220.0" text="FINALIZAR">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                    <VBox.margin>
                        <Insets bottom="25.0" top="10.0" />
                    </VBox.margin>
                </Button>
            </children>
        </VBox>
                    </children>
                </StackPane>
            </content>
        </ScrollPane>
    </children>
</AnchorPane>
