<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="650.0" prefWidth="761.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.petshoppoo.controllers.PetListaController" stylesheets="@../styles/petshop.css">

    <children>

        <HBox alignment="CENTER_LEFT" spacing="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
            <children>
                <Button fx:id="btnVoltar" styleClass="secondary" onAction="#handleVoltar" prefHeight="44.0" prefWidth="83.0" text="&lt;- BACK">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Button>
                <Region HBox.hgrow="ALWAYS" />
                <Label styleClass="page-title" text="Meus Animais">
                    <font>
                        <Font name="System Bold" size="32.0" />
                    </font>
                </Label>
                <Region HBox.hgrow="ALWAYS" />
            </children>
        </HBox>

        <Separator AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="80.0" />


        <TableView fx:id="tabelaPets" prefHeight="280.0" AnchorPane.leftAnchor="31.0" AnchorPane.rightAnchor="31.0" AnchorPane.topAnchor="102.0" AnchorPane.bottomAnchor="250.0">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="clNome" prefWidth="120.0" text="Nome" />
                <TableColumn fx:id="clEspecie" prefWidth="100.0" text="Espécie" />
                <TableColumn fx:id="clRaca" prefWidth="120.0" text="Raça" />
                <TableColumn fx:id="clIdade" prefWidth="80.0" text="Idade" />
                <TableColumn fx:id="clPeso" prefWidth="80.0" text="Peso (kg)" />
                <TableColumn fx:id="clAdestrado" prefWidth="100.0" text="Adestrado" />
                <TableColumn fx:id="clCastrado" prefWidth="100.0" text="Castrado" />
            </columns>
        </TableView>


        <VBox fx:id="painelEdicao" styleClass="edit-card" spacing="15.0" visible="false" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.bottomAnchor="25.0">

            <children>
                <Label text="Editar Pet">
                    <font>
                        <Font name="System Bold" size="18.0" />
                    </font>
                </Label>


                <HBox spacing="15.0">
                    <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                        <Label text="Nome" />
                        <TextField fx:id="txtNome" prefHeight="35.0" />
                    </VBox>

                    <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                        <Label text="Raça" />
                        <TextField fx:id="txtRaca" prefHeight="35.0" />
                    </VBox>

                    <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                        <Label text="Peso (kg)" />
                        <TextField fx:id="txtPeso" prefHeight="35.0" />
                    </VBox>
                </HBox>


                <HBox alignment="CENTER" spacing="30.0">
                    <CheckBox fx:id="chkAdestrado" text="Adestrado" />
                    <CheckBox fx:id="chkCastrado" text="Castrado" />
                </HBox>


                <HBox alignment="CENTER" spacing="15.0">
                    <Button fx:id="btnSalvar" onAction="#handleSalvar" prefHeight="40.0" prefWidth="200.0" text="Salvar">
                        <font>
                            <Font name="System Bold" size="14.0" />
                        </font>
                    </Button>
                    <Button fx:id="btnCancelar" styleClass="secondary" onAction="#handleCancelar" prefHeight="40.0" prefWidth="200.0" text="Cancelar">
                        <font>
                            <Font name="System Bold" size="14.0" />
                        </font>
                    </Button>
                </HBox>
            </children>
        </VBox>


        <HBox fx:id="botoesAcao" alignment="CENTER" spacing="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.bottomAnchor="25.0">
            <Button fx:id="btnEditar" styleClass="secondary" onAction="#handleEditar" prefHeight="45.0" prefWidth="200.0" text="Editar">
                <font>
                    <Font name="System Bold" size="14.0" />
                </font>
            </Button>
            <Button fx:id="btnDeletar" styleClass="danger" onAction="#handleDeletar" prefHeight="45.0" prefWidth="200.0" text="Deletar">
                <font>
                    <Font name="System Bold" size="14.0" />
                </font>
            </Button>
        </HBox>
    </children>
</AnchorPane>
