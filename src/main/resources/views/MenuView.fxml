<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane minHeight="420.0" minWidth="640.0" prefHeight="516.0" prefWidth="944.0"
           style="-fx-background-color: #F5F5DC; -fx-border-color: #8B7D6B; -fx-border-width: 8px;"
           xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="org.example.petshoppoo.controllers.MenuController">
    <children>
        <BorderPane>
            <top>
                <StackPane prefHeight="100.0">
                    <Label alignment="CENTER" text="GOLDEN PET  🐾" textFill="#ffb300">
                        <font><Font name="Serif Bold" size="48.0" /></font>
                    </Label>
                    <Button fx:id="btnMenu" mnemonicParsing="false" onAction="#toggleMenu"
                            style="-fx-background-color: #ffb300; -fx-cursor: hand; -fx-background-radius: 5;"
                            text="☰" textFill="WHITE" StackPane.alignment="TOP_RIGHT">
                        <font><Font name="System Bold" size="20.0" /></font>
                        <StackPane.margin><Insets right="20.0" top="20.0" /></StackPane.margin>
                    </Button>
                </StackPane>
            </top>
            <center>
                <HBox alignment="CENTER" spacing="35.0">
                    <padding><Insets bottom="25.0" left="35.0" right="35.0" top="15.0" /></padding>
                    <VBox alignment="CENTER" maxWidth="260.0" prefWidth="230.0" spacing="15.0">
                        <Button fx:id="CadastroPet" maxWidth="Infinity" alignment="CENTER" mnemonicParsing="false" onAction="#handleCadastrarPet" prefHeight="70.0" style="-fx-background-radius: 10; -fx-border-color: #E0E0E0; -fx-border-radius: 10; -fx-background-color: #EFEBE9; -fx-cursor: hand;" text="🐾 Cadastrar Pet" textFill="#ffb300">
                            <font><Font name="MS Gothic" size="21.0" /></font>
                        </Button>
                        <Button fx:id="ListaPets" maxWidth="Infinity" alignment="CENTER" mnemonicParsing="false" onAction="#handleListarPets" prefHeight="70.0" style="-fx-background-radius: 10; -fx-border-color: #E0E0E0; -fx-border-radius: 10; -fx-background-color: #EFEBE9; -fx-cursor: hand;" text="📋 Listar Pets" textFill="#ffb300">
                            <font><Font name="MS Gothic" size="23.0" /></font>
                        </Button>
                        <Button fx:id="Servicos" maxWidth="Infinity" alignment="CENTER" mnemonicParsing="false" onAction="#handleServicos" prefHeight="70.0" style="-fx-background-radius: 10; -fx-border-color: #E0E0E0; -fx-border-radius: 10; -fx-background-color: #EFEBE9; -fx-cursor: hand;" text="🔧 Serviços" textFill="#ffb300">
                            <font><Font size="28.0" /></font>
                        </Button>
                        <Button fx:id="Agendamento" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleAgendamentos" prefHeight="70.0" style="-fx-background-radius: 10; -fx-border-color: #E0E0E0; -fx-border-radius: 10; -fx-background-color: #EFEBE9; -fx-cursor: hand;" text="📅 Agendamentos" textFill="#ffb300">
                            <font><Font size="21.0" /></font>
                        </Button>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" />
                    <ImageView fitHeight="280.0" fitWidth="280.0" preserveRatio="true" HBox.hgrow="ALWAYS">
                        <image><Image url="@../images/AnimalMenu.png" /></image>
                    </ImageView>
                </HBox>
            </center>
        </BorderPane>

        <VBox fx:id="menuLateral" maxHeight="Infinity" maxWidth="210.0" prefHeight="516.0" prefWidth="210.0"
              style="-fx-background-color: white; -fx-border-color: #8B7D6B; -fx-border-width: 0 0 0 8;"
              StackPane.alignment="CENTER_RIGHT">
            <children>
                <HBox alignment="TOP_RIGHT" prefWidth="200.0">
                    <children>
                        <Button fx:id="Volta" mnemonicParsing="false" onAction="#handleVoltar" prefHeight="25.0" prefWidth="35.0" style="-fx-background-radius: 5; -fx-border-color: #E0E0E0; -fx-border-radius: 5; -fx-background-color: #EFEBE9; -fx-cursor: hand;" text="⏎" textFill="#faaf00">
                            <font><Font name="System Bold" size="14.0" /></font>
                        </Button>
                    </children>
                    <VBox.margin><Insets right="10.0" top="10.0" /></VBox.margin>
                </HBox>
                <Label alignment="CENTER" maxWidth="Infinity" prefHeight="40.0" text="MENU" textFill="#ffb300">
                    <font><Font name="System Bold" size="22.0" /></font>
                    <VBox.margin><Insets bottom="10.0" /></VBox.margin>
                </Label>
                <Button fx:id="Perfil" maxWidth="Infinity" mnemonicParsing="false" onAction="#handlePerfil" prefHeight="45.0" style="-fx-background-color: transparent; -fx-cursor: hand;" text="👤 Meu Perfil" textFill="#555555">
                    <font><Font size="15.0" /></font>
                </Button>
                <Button fx:id="Suporte" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleSuporte" prefHeight="45.0" style="-fx-background-color: transparent; -fx-cursor: hand;" text="🛠 Suporte" textFill="#555555">
                    <font><Font size="15.0" /></font>
                </Button>
                <Separator prefWidth="200.0">
                    <VBox.margin><Insets bottom="10.0" top="10.0" /></VBox.margin>
                </Separator>
                <Button fx:id="SairDaConta" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleSairDaConta" prefHeight="45.0" style="-fx-background-color: #EFEBE9; -fx-text-fill: #ffb300; -fx-cursor: hand; -fx-background-radius: 8;" text="🚪 Sair da Conta">
                    <font><Font name="System Bold" size="14.0" /></font>
                    <VBox.margin><Insets left="12.0" right="12.0" /></VBox.margin>
                </Button>
            </children>
        </VBox>
    </children>
</StackPane>
